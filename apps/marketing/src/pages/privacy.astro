---
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbSchema } from '../lib/schema';

const title = 'Privacy Policy — Dynamic QR Code Labs';
const description =
  'How Dynamic QR Code Labs collects, stores, and protects your data. We hash IPs, use approximate location only, and never sell or share user data.';

const jsonLd = breadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Privacy', url: '/privacy/' },
]);
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <article class="article" style="max-width: 760px;">
    <h1>Privacy Policy</h1>
    <p style="color: var(--text-muted);">Last updated: May 12, 2026</p>

    <div class="article-body">
      <h2>Our principles</h2>
      <p>We collect the minimum data needed to operate the platform. We hash IP addresses before storage. We use approximate location data (country, city) only. We never sell, rent, or share user data with third parties.</p>

      <h2>What we collect</h2>
      <p>Account data (email, name, hashed password). QR code data you create. Anonymized scan events (hashed IP, country, city, device type, OS, browser, referrer, UTM parameters, timestamp). Standard server logs for security and uptime monitoring.</p>

      <h2>What we do not collect</h2>
      <p>We do not store raw IP addresses, precise GPS coordinates, names of scanners, or any personal information about the people who scan your QR codes. The scanning experience is anonymous by design.</p>

      <h2>Cookies</h2>
      <p>We use cookies only for authentication and session management on the dashboard. We do not use third-party advertising cookies or trackers on this site.</p>

      <h2>Data retention</h2>
      <p>Scan analytics are retained according to your plan: 30 days on Free, 90 days on Starter, and unlimited on Pro and above. Account data is retained until you delete your account. After deletion, all personal data is purged within 30 days.</p>

      <h2>Your rights</h2>
      <p>You can export all your data at any time from the dashboard. You can delete your account and all associated data at any time. We comply with GDPR and CCPA, including data subject access requests and deletion requests.</p>

      <h2>Contact</h2>
      <p>Privacy questions: <a href="mailto:privacy@dynamicqrcodelabs.com">privacy@dynamicqrcodelabs.com</a>.</p>
    </div>
  </article>
</BaseLayout>
