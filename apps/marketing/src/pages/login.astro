---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Log in — Dynamic QR Code Labs';
const description =
  'Log in to your Dynamic QR Code Labs account to manage QR codes, view analytics, edit destinations, and download branded designs in under a minute.';
---

<BaseLayout title={title} description={description}>
  <section class="container" style="max-width: 440px; padding: 80px 24px;">
    <div style="text-align: center; margin-bottom: 32px;">
      <h1 style="font-size: 1.8rem;">Welcome back</h1>
      <p style="color: var(--text-soft);">Log in to manage your QR codes and view analytics.</p>
    </div>

    <form
      id="login-form"
      method="post"
      action="/api/auth/login"
      style="display: flex; flex-direction: column; gap: 14px; background: #fff; border: 1px solid var(--border); border-radius: 16px; padding: 32px;"
    >
      <label style="display: flex; flex-direction: column; gap: 6px; font-size: 0.92rem; font-weight: 600;">
        Email
        <input
          type="email"
          name="email"
          required
          autocomplete="email"
          style="padding: 11px 14px; border: 1px solid var(--border-strong); border-radius: 8px; font-size: 1rem;"
        />
      </label>

      <label style="display: flex; flex-direction: column; gap: 6px; font-size: 0.92rem; font-weight: 600;">
        Password
        <input
          type="password"
          name="password"
          required
          autocomplete="current-password"
          style="padding: 11px 14px; border: 1px solid var(--border-strong); border-radius: 8px; font-size: 1rem;"
        />
      </label>

      <button type="submit" class="btn btn-primary" style="justify-content: center; margin-top: 8px;">
        Log in
      </button>

      <p id="login-msg" role="alert" style="margin: 0; min-height: 1.2em; font-size: 0.9rem; color: var(--danger);"></p>
    </form>

    <p style="text-align: center; margin-top: 20px; font-size: 0.92rem; color: var(--text-soft);">
      New here? <a href="/signup/">Create a free account</a>
    </p>
  </section>

  <script>
    const form = document.querySelector<HTMLFormElement>('#login-form');
    const msg = document.querySelector<HTMLParagraphElement>('#login-msg');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form || !msg) return;
      msg.textContent = '';
      const fd = new FormData(form);
      const payload = Object.fromEntries(fd.entries());
      try {
        const apiBase = import.meta.env.PUBLIC_API_URL || '';
        const res = await fetch(`${apiBase}/api/auth/login`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          msg.textContent = data.error || 'Invalid email or password.';
          return;
        }
        window.location.href = 'https://app.dynamicqrcodelabs.com/dashboard';
      } catch (err) {
        msg.textContent = 'Network error. Please try again.';
      }
    });
  </script>
</BaseLayout>
